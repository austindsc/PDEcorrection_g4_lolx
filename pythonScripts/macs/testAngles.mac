# medium = air
# Nphoton = 100000, wlStart = 420, wlEnd = 420, wlStep = 25, 
#angleLow = 0, angleHigh = 50, angleStep = 10

# --- --- --- --- --- # 

/vis/verbose 0
/tracking/verbose 0
/event/verbose 0
/process/had/verbose 0
/run/verbose 0
/particle/verbose 0
/tracking/verbose 0

/process/em/verbose 0
/process/optical/verbose 0
#/process/optical/scintillation/verbose 1

/process/optical/processActivation OpRayleigh false
/process/optical/processActivation OpAbsorption false
/process/optical/processActivation OpBoundary true
/process/optical/processActivation OpMieHG false
/process/optical/processActivation OpWLS false


# --- --- --- --- --- # 

/setDetector/myVerbosity 0
/setMaterial/detectionMedium air
# --- --- --- --- --- # 

/analysis/setFileName testAngles 
/run/initialize 

# --- --- --- --- --- # 

/gps/pos/type Point
/gps/particle opticalphoton

/gps/position 0 -5. 0.5 cm
/gps/number 100000
/gps/ang/minphi -90 deg
/gps/ang/maxphi -90 deg
# --- --- --- --- --- # 

/gps/ene/mono 2.95 eV

/gps/ang/mintheta 0.0 deg 
/gps/ang/maxtheta 0.0 deg 
/run/beamOn 1

# --- --- --- # 

/gps/ang/mintheta 50.0 deg 
/gps/ang/maxtheta 50.0 deg 
/run/beamOn 1

/gps/ang/mintheta 51.0 deg 
/gps/ang/maxtheta 51.0 deg 
/run/beamOn 1

/gps/ene/mono 5 eV
/gps/ang/mintheta 50.0 deg 
/gps/ang/maxtheta 50.0 deg 
/run/beamOn 1

/gps/ene/mono 5.2 eV
/gps/ang/mintheta 50.0 deg 
/gps/ang/maxtheta 50.0 deg 
/run/beamOn 1

/gps/ene/mono 5 eV
/gps/ang/mintheta 50.0 deg 
/gps/ang/maxtheta 50.0 deg 
/run/beamOn 1

# --- --- --- # 

# END