/gps/particle opticalphoton
/gps/pos/type Point

#/gps/pos/type Plane
#/gps/pos/shape Circle
#/gps/pos/radius 2 cm

/gps/number 1000

#/gps/pos/centre 0. 0. -0.5 cm # photons out
#/gps/direction 0. 1 1 

/gps/pos/centre 0. -2. 0.75 cm # photons in
#/gps/direction 0. 1. -1 

/gps/ene/mono 1.5 eV
#/gps/ene/mono 2 eV
#/gps/ene/mono 7.1 eV # lXe peak

/gps/ang/mintheta 15.0 deg 
/gps/ang/maxtheta 15.0 deg

/gps/ang/minphi -90.0 deg 
/gps/ang/maxphi -90.0 deg
/run/beamOn 1

#/analysis/setFileName photonTest1
#/analysis/ntuple/setFileName 0 anotherNameIWant3

#/run/initialize

#/run/beamOn 1