# this produces many photons from all over a disk


/gps/particle opticalphoton
/gps/energy 5 eV
/gps/pos/type Point
/gps/number 10000

#/gps/pos/centre 0. 0. -0.5 cm # photons out
#/gps/direction 0. 1 1 

/gps/pos/centre 0. -5. 0.5 cm # photons in
#/gps/direction 0. 1. -1 

#/gps/ang/mintheta 90 deg
#/gps/ang/maxtheta 90 deg

/gps/ene/mono 1.3 eV
/gps/ang/mintheta 10.0 deg 
/gps/ang/maxtheta 10.0 deg

/gps/ang/minphi -90.0 deg 
/gps/ang/maxphi -90.0 deg
/run/beamOn 1

#/analysis/setFileName photonTest1
#/analysis/ntuple/setFileName 0 anotherNameIWant3

#/run/initialize

#/run/beamOn 1